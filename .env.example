# Google OAuth2 credentials - obtain from Google Cloud Console
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# PostgreSQL database credentials
DB_USERNAME=<your-db-username>
DB_PASSWORD=<your-db-password>

# Mailtrap email sending - obtain API token from mailtrap.io
MAILTRAP_API_TOKEN=<your-mailtrap-api-token>
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=Tagly

# Password reset link base URL (points at the frontend reset page)
# Use one of the two lines below depending on the environment:
# RESET_LINK_BASE=http://localhost:8081/reset-password
RESET_LINK_BASE=http://193.40.157.127/reset-password

# Set to true only when the server is behind HTTPS — leave false for plain HTTP
SESSION_COOKIE_SECURE=false